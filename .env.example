# Server-only. Never prefix this with NEXT_PUBLIC_ or commit a real key.
GROQ_API_KEY=
# Optional model override. Check https://console.groq.com/docs/models for current models.
GROQ_MODEL=openai/gpt-oss-120b
# Server-only Google Cloud Translation (v2) key for Hindi, Bengali, Gujarati, Kannada, Tamil, Marathi.
GOOGLE_TRANSLATE_API_KEY=
# Optional hosted RSVP. Use your Firebase/GCP project id and Firestore Native mode.
# Cloud Run uses Application Default Credentials; grant the service account roles/datastore.user.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
# Server-only secret (24+ characters) used to sign guest RSVP links. Rotating it invalidates old links.
RSVP_SIGNING_SECRET=
